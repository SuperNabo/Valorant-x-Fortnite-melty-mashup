{
  "schemaVersion": 1,
  "slug": "fortnant",
  "title": "Fortnant",
  "tagline": "VALORANT agents and tactical abilities meets Fortnite building and map design.",
  "description": "Fortnant combines VALORANT agent abilities, tactical spike-plant rounds, and weapon economies with Fortnite's iconic real-time building mechanics in a high-stakes Deathmatch mode with multiplayer and bots.",
  "mode": "installed",
  "games": [
    {
      "slug": "fortnite",
      "role": "primary"
    },
    {
      "slug": "valorant",
      "role": "companion"
    }
  ],
  "license": "MIT",
  "remixAllowed": true,
  "launch": {
    "kind": "game"
  },
  "components": [
    {
      "id": "readme",
      "label": "README",
      "fileName": "README.md",
      "kind": "main"
    },
    {
      "id": "weapons",
      "label": "sheetsweapons",
      "fileName": "sheetsweapons.json",
      "kind": "main"
    },
    {
      "id": "building",
      "label": "sheetsbuilding",
      "fileName": "sheetsbuilding.json",
      "kind": "main"
    },
    {
      "id": "rules",
      "label": "sheetsrules",
      "fileName": "sheetsrules.json",
      "kind": "main"
    }
  ],
  "mappings": [
    {
      "component": "readme",
      "from": "",
      "to": "{managed}/Fortnant/README.md"
    },
    {
      "component": "weapons",
      "from": "",
      "to": "{managed}/Fortnant/sheetsweapons.json"
    },
    {
      "component": "building",
      "from": "",
      "to": "{managed}/Fortnant/sheetsbuilding.json"
    },
    {
      "component": "rules",
      "from": "",
      "to": "{managed}/Fortnant/sheetsrules.json"
    }
  ],
  "multiplayer": {
    "maxPlayers": 10,
    "connect": {
      "address": {
        "log": "{localappdata}/Fortnant/logs/latest.log",
        "after": "Hosting at "
      },
      "hostArgs": [
        "--host",
        "--port",
        "{port}",
        "--mode",
        "deathmatch",
        "--bots",
        "true"
      ],
      "joinArgs": [
        "--join",
        "{address}"
      ]
    }
  },
  "test": {
    "checks": [
      "agent_abilities_verified",
      "building_grid_active",
      "deathmatch_bots_active"
    ]
  }
}
