{
  "slug": "fortnant",
  "title": "Fortnant",
  "tagline": "VALORANT agents and tactical abilities meets Fortnite building and map design.",
  "description": "Fortnant combines VALORANT agent abilities, tactical spike-plant rounds, and weapon economies with Fortnite's iconic real-time building mechanics.",
  "primary": "fortnite",
  "companions": [
    "valorant"
  ],
  "license": "MIT",
  "remixAllowed": true,
  "components": [
    {
      "fileName": "README.md",
      "destination": "{mod}/README.md"
    },
    {
      "fileName": "sheetsweapons.json",
      "destination": "{mod}/sheetsweapons.json"
    },
    {
      "fileName": "sheetsagents.json",
      "destination": "{mod}/sheetsagents.json"
    },
    {
      "fileName": "sheetsrules.json",
      "destination": "{mod}/sheetsrules.json"
    },
    {
      "fileName": "sheetsbuilding.json",
      "destination": "{mod}/sheetsbuilding.json"
    }
  ],
  "multiplayer": {
    "maxPlayers": 10,
    "connect": {
      "address": {
        "log": "{localappdata}/Fortnant/logs/latest.log",
        "after": "Hosting at "
      },
      "hostArgs": [
        "--host",
        "--port",
        "{port}"
      ],
      "joinArgs": [
        "--join",
        "{address}"
      ]
    }
  },
  "test": {
    "checks": [
      "agent_abilities_verified",
      "building_grid_active",
      "spike_round_active"
    ]
  }
}
